{
  "name": "wave-mcp-connector",
  "private": true,
  "version": "1.0.0",
  "description": "Hosted OAuth remote MCP connector for Wave Accounting on Cloudflare Workers. Not affiliated with Wave Financial Inc.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "types": "wrangler types",
    "test:integration": "node test/migration.integration.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "agents": "0.21.0",
    "hono": "^4.12.27",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
    "@modelcontextprotocol/client": "2.2.0",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
